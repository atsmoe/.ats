---
permalink: ./ff14-journeys.html
title: 最终幻想XIV · 旅途星座
bodyClass: world-ff14 ff-journeys-page
pageType: ff14-journeys
worldId: ff14
cssFiles:
  - base.css
  - nav.css
  - worlds.css
  - ff14-world.css
  - responsive.css
---
{% extends "base.njk" %}

{% block content %}
<article class="ff-journeys" id="journey-constellation" aria-labelledby="journey-title">
  <header class="ff-journey-hero">
    <a class="ff-backlink" href="./ff14.html">← ÆTHERIS / 水晶星海入口</a>
    <p class="ff-eyebrow">THE ROAD GOES EVER ON / JOURNEY CONSTELLATION</p>
    <h1 id="journey-title">旅途<span>星座</span></h1>
    <p>编年回答“先后”，这里聚焦每段旅途的目的地与改变。6.0终章与6.1新开端各自成星，后续故事由新的航路继续延展。</p>
    <div class="ff-journey-meta"><span>EIGHT ARCS</span><span>1.x → 7.5 PART 1</span><span>FULL STORY SPOILERS</span></div>
  </header>

  <div class="ff-constellation">
    <svg class="ff-constellation-path" viewBox="0 0 1200 280" preserveAspectRatio="none" aria-hidden="true">
      <path d="M54 180C170 30 250 238 370 116S560 52 650 166 820 240 910 108 1065 46 1150 142"/>
      <path class="ff-constellation-path-glow" d="M54 180C170 30 250 238 370 116S560 52 650 166 820 240 910 108 1065 46 1150 142"/>
    </svg>
    <div class="ff-journey-nodes" role="group" aria-label="选择旅途篇章">
      {% for journey in ff14Catalog.journeys %}
      <button class="ff-journey-node{% if loop.first %} is-active{% endif %}{% if journey.id === 'dawntrail' %} is-current{% endif %}"
        type="button"
        data-journey-id="{{ journey.id }}"
        aria-pressed="{% if loop.first %}true{% else %}false{% endif %}"
        aria-controls="{{ journey.id }}">
        <i></i><span>{{ journey.version }}</span><strong>{{ journey.name }}</strong>
      </button>
      {% endfor %}
    </div>
  </div>

  <div class="ff-journey-panels" aria-live="polite">
    {% for journey in ff14Catalog.journeys %}
    <section class="ff-journey-panel" id="{{ journey.id }}" data-journey-panel="{{ journey.id }}" {% if not loop.first %}hidden{% endif %}>
      <header>
        <span>{{ journey.version }}</span>
        <div><small>{{ journey.latin }}{% if journey.editorial %} / SITE READING PATH{% endif %}</small><h2>{{ journey.name }}</h2><p>{{ journey.place }}</p></div>
      </header>
      <p class="ff-journey-summary">{{ journey.summary }}</p>
      <div class="ff-journey-records">
        {% for record in journey.records %}
        <a href="./ff14-chronicle.html#{{ record.id }}"><time>{{ record.dateDisplay }}</time><strong>{{ record.title }}</strong><i>读取记录 →</i></a>
        {% endfor %}
      </div>
      <footer>{% for source in journey.sources %}<a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.title }} ↗</a>{% endfor %}</footer>
    </section>
    {% endfor %}
  </div>

  <aside class="ff-current-boundary">
    <span>CURRENT PUBLIC BOUNDARY</span>
    <strong>Patch {{ ff14Catalog.coverage.currentPatch }} / Story {{ ff14Catalog.coverage.storyThrough }}</strong>
    <p>{{ ff14Catalog.coverage.notice }}</p>
    <div class="ff-boundary-sources">
      {% for source in ff14Catalog.coverage.sources %}
      <a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.title }} ↗</a>
      {% endfor %}
    </div>
  </aside>
</article>
<noscript><style>.world-ff14 .ff-constellation{display:none!important}.world-ff14 .ff-journey-panel[hidden]{display:block!important}.world-ff14 .ff-journey-panels{max-height:none!important;overflow:visible!important}</style></noscript>
{% endblock %}
