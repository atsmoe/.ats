---
permalink: ./wh40k-chronicle.html
title: 战锤40K · 银河纪元
bodyClass: world-wh40k wh-chronicle-page
pageType: world
worldId: wh40k
viewId: wh40k-chronicle
cssFiles:
  - base.css
  - nav.css
  - timeline.css
  - worlds.css
  - wh40k-world.css
  - responsive.css
---
{% extends "base.njk" %}

{% block content %}
<div id="timeline" class="active wh-chronicle">
  <header class="tl-cover wh-chronicle-cover">
    <div class="tl-cover-inner">
      <a class="wh-backlink" href="./wh40k.html">← GALAXY / 破碎银河入口</a>
      <p class="wh-eyebrow">ORDO CHRONOS / CURATED SEQUENCE</p>
      <h1>银河纪元</h1>
      <p>按显式年代等级重排；已确认错误或重复的条目从默认时序降级。旧有长篇仍在逐条补来源，完成前均标注为待核验。</p>
      <p class="wh-chronicle-notice">{{ wh40k.archive.coverage.notice }}</p>
      <div class="calendar-badge">银河纪元 / 帝国历</div>
    </div>
  </header>

  <div class="tl-branches" id="tl-branches"></div>
  <div class="tl-sub-branches" id="tl-sub-branches" style="display:none;"></div>
  <div class="tl-container" id="tl-container"></div>
</div>

<noscript>
  <article class="wh-noscript-chronicle" aria-labelledby="wh-noscript-title">
    <header>
      <p class="wh-eyebrow">OFFLINE CODEX / CURATED SEQUENCE</p>
      <h2 id="wh-noscript-title">银河纪元静态档案</h2>
      <p>{{ wh40kCatalog.coverage.notice }}</p>
    </header>
    {% for era in wh40kCatalog.chronicleEras %}
    <section class="wh-noscript-era">
      <h3>{{ era.title }}</h3>
      {% for record in era.events %}
      <article id="{{ record.id }}" class="wh-noscript-record">
        <time>{{ record.dateDisplay }}</time>
        <h4>{{ record.title }}</h4>
        <p>{{ record.description }}</p>
      </article>
      {% endfor %}
    </section>
    {% endfor %}
  </article>
</noscript>

<div id="event-modal" class="event-modal-overlay" style="display:none;">
  <div class="event-modal-card" role="dialog" aria-modal="true" aria-labelledby="event-modal-title-wh40k" aria-describedby="event-modal-desc-wh40k">
    <button class="event-modal-close" title="关闭">✕</button>
    <div class="event-modal-date"></div>
    <div class="event-modal-title" id="event-modal-title-wh40k"></div>
    <div class="event-modal-meta"></div>
    <div class="event-modal-desc" id="event-modal-desc-wh40k"></div>
    <div class="event-modal-img"></div>
    <div class="event-modal-sources"></div>
  </div>
</div>

<nav id="era-nav" aria-label="时代索引"></nav>
<button id="back-to-top" title="回到顶部">▲</button>
{% endblock %}

{% block extraScripts %}<script defer src="./js/virtual-timeline.js"></script>{% endblock %}
