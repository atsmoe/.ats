<!DOCTYPE html>
<html lang="zh-CN">
<head>
  {% set documentTitle = title ~ " — " ~ site.title %}
  {% if title === "群星之间" %}{% set documentTitle = site.title %}{% endif %}
  {% set documentDescription = description or site.description %}
  {% set canonicalUrl = site.canonicalBase ~ page.url %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ documentTitle }}</title>
  <meta name="description" content="{{ documentDescription }}">
  <meta name="robots" content="index,follow">
  <meta name="theme-color" content="#060a14">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:locale" content="zh_CN">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ documentTitle }}">
  <meta property="og:description" content="{{ documentDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta name="twitter:card" content="summary">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.loli.net" crossorigin>
  <link href="https://fonts.loli.net/css2?family=Noto+Serif+SC:wght@400;700;900&family=Noto+Sans+SC:wght@300;400;700&display=swap" rel="stylesheet">

  <!-- CSS -->
  {% if eleventy.env.runMode === "serve" %}
    {% linkCSS cssFiles %}
  {% else %}
    {% inlineCSS cssFiles %}
  {% endif %}
</head>
<body class="{{ bodyClass }}" data-page="{{ pageType }}" {% if worldId %}data-world="{{ worldId }}"{% endif %}{% if contextId %} data-context="{{ contextId }}"{% endif %}{% if viewId %} data-view="{{ viewId }}"{% endif %} data-version="{{ buildVersion }}">

  <a class="skip-link" href="#main-content">跳到主要内容</a>

  <!-- CRITICAL: portal arrival overlay — first element in body, not in any block -->
  <div id="portal-arrival" aria-hidden="true"></div>
  <noscript><style>#portal-arrival { display: none !important; }</style></noscript>

  {% include "nav.njk" %}

  <main id="main-content" tabindex="-1">
    {% block content %}{% endblock %}
  </main>

  {% include "footer.njk" %}

  <!-- Background layers -->
  <canvas id="bg-canvas" style="position:fixed;inset:0;z-index:0;"></canvas>
  <video id="bg-video" loop muted playsinline style="display:none;position:fixed;inset:0;z-index:0;object-fit:cover;"></video>
  <img id="bg-image" alt="" style="display:none;position:fixed;inset:0;z-index:0;object-fit:cover;">

  <!-- Wormhole transition canvas -->
  <canvas id="wormhole" style="position:fixed;inset:0;z-index:300;pointer-events:none;display:none;"></canvas>

  <!-- JS: virtual-timeline loads first (small, defines VirtualTimeline global needed by world bundle) -->
  {% block extraScripts %}{% endblock %}
  {% if scriptFile %}
  <script defer src="./js/{{ scriptFile }}?v={{ buildVersion }}"></script>
  {% else %}
  <script defer src="./js/bundle.js?v={{ buildVersion }}"></script>
  {% endif %}
</body>
</html>
