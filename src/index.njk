---
permalink: ./index.html
title: 群星之间
bodyClass: world-index
pageType: star-map
scriptFile: star-map-3d.js
cssFiles:
  - base.css
  - nav.css
  - star-map.css
  - worlds.css
  - responsive.css
---
{% extends "base.njk" %}

{% block content %}
<!-- LOCAL_PROTOTYPE_SWITCH_START -->
<a
  class="star-map-version-switch"
  data-local-prototype-toggle
  href="./star-map-b4-prototype.html"
  aria-label="切换至 B4 星图原型"
>
  <span>LOCAL PREVIEW</span>
  <strong>切换至 B4 星图原型</strong>
</a>
<!-- LOCAL_PROTOTYPE_SWITCH_END -->

<!-- Star Map View -->
<div id="star-map">
  <h1 class="sr-only">群星之间 · 世界档案</h1>
  <!-- 3D cluster markers (positioned by star-map-3d.js) -->
  <div id="galaxy-markers">
    <a class="galaxy-marker" id="marker-arknights" data-world="arknights" href="./arknights.html">
      <div class="galaxy-marker-glow" style="--marker-color: #d4923a;"></div>
      <div class="galaxy-marker-core" style="--marker-color: #d4923a;"></div>
      <div class="galaxy-marker-label">泰拉大陆</div>
    </a>
    <a class="galaxy-marker" id="marker-wh40k" data-world="wh40k" href="./wh40k.html">
      <div class="galaxy-marker-glow" style="--marker-color: #c85050;"></div>
      <div class="galaxy-marker-core" style="--marker-color: #c85050;"></div>
      <div class="galaxy-marker-label">破碎银河</div>
    </a>
    <a class="galaxy-marker" id="marker-ff14" data-world="ff14" href="./ff14.html">
      <div class="galaxy-marker-glow" style="--marker-color: #b8c4d8;"></div>
      <div class="galaxy-marker-core" style="--marker-color: #b8c4d8;"></div>
      <div class="galaxy-marker-label">艾欧泽亚</div>
    </a>
  </div>

  <!-- Galaxy hover tooltip -->
  <div class="galaxy-tooltip" id="galaxy-tooltip">
    <div class="gt-name" id="gt-name"></div>
    <div class="gt-sub" id="gt-sub"></div>
    <div class="gt-hint">点击查看详情</div>
  </div>
</div>

<!-- Galaxy detail overlay -->
<div id="galaxy-detail"
  role="dialog"
  aria-modal="true"
  aria-labelledby="detail-title"
  aria-describedby="detail-desc"
  aria-hidden="true"
  inert>
  <div class="detail-overlay" id="detail-overlay"></div>
  <button class="detail-close" id="detail-close" type="button" aria-label="关闭世界详情">✕</button>
  <div class="detail-content">
    <div class="detail-body">
      <canvas id="galaxy-canvas" width="640" height="640"></canvas>
    </div>
    <div class="detail-title" id="detail-title"></div>
    <div class="detail-sub" id="detail-sub"></div>
    <p class="detail-desc" id="detail-desc"></p>
    <div class="detail-calendar" id="detail-calendar"></div>
    <button class="btn-detail-enter" id="detail-enter-btn" type="button">进入编年史</button>
  </div>
</div>
{% endblock %}
