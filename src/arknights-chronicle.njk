---
permalink: ./arknights-chronicle.html
title: 明日方舟 · 主世界线
bodyClass: world-arknights ark-chronicle-page
pageType: arknights-chronicle
worldId: arknights
viewId: chronicle
cssFiles:
  - base.css
  - nav.css
  - timeline.css
  - arknights-world.css
  - ref-panel.css
  - worlds.css
  - responsive.css
  - arknights-chronicle.css
---
{% extends "base.njk" %}

{% block content %}
<div id="timeline" class="active">
  <header class="tl-cover">
    <div class="tl-cover-inner">
      <span class="tl-cover-kicker">TERRA / ORIGINIUM OBSERVATION</span>
      <a class="tl-cover-back" href="./arknights.html"><span aria-hidden="true">←</span> 泰拉档案入口</a>
      <h1>明日方舟 · 主世界线</h1>
      <p>从前文明遗迹到罗德岛当下，按时间顺序查阅这片大地的事件。</p>
      <div class="tl-cover-footer">
        <div class="calendar-badge">泰 拉 历</div>
        <span class="tl-cover-status">CHRONICLE NODE ARRAY / ONLINE</span>
      </div>
    </div>

    <div class="tl-cover-telemetry" aria-hidden="true">
      <div class="tl-telemetry-head">
        <span>LANDSHIP ROUTE OBSERVATION</span>
        <span>ARK / 01-CHRONICLE</span>
      </div>
      <svg viewBox="0 0 920 430" preserveAspectRatio="xMidYMid slice">
        <g class="tl-telemetry-grid-lines">
          <path d="M40 82H880M40 162H880M40 242H880M40 322H880" />
          <path d="M120 28V398M280 28V398M440 28V398M600 28V398M760 28V398" />
        </g>
        <g class="tl-telemetry-orbits">
          <ellipse cx="592" cy="217" rx="246" ry="126" />
          <ellipse cx="592" cy="217" rx="164" ry="82" />
          <circle cx="592" cy="217" r="34" />
        </g>
        <path class="tl-telemetry-route tl-telemetry-route--ghost" d="M28 316C122 298 174 195 280 211S410 337 514 278 632 90 742 112s112 99 162 78" />
        <path class="tl-telemetry-route tl-telemetry-route--active" d="M28 316C122 298 174 195 280 211S410 337 514 278 632 90 742 112s112 99 162 78" />
        <g class="tl-telemetry-nodes">
          <circle cx="118" cy="276" r="7" />
          <circle cx="280" cy="211" r="5" />
          <circle cx="430" cy="307" r="6" />
          <circle cx="592" cy="217" r="12" class="tl-telemetry-node--core" />
          <circle cx="742" cy="112" r="7" />
          <circle cx="858" cy="185" r="5" />
        </g>
        <g class="tl-telemetry-reticle">
          <path d="M592 163V188M592 246V271M538 217H563M621 217H646" />
          <path d="M558 183L572 197M612 237L626 251M626 183L612 197M572 237L558 251" />
        </g>
        <g class="tl-telemetry-labels">
          <text x="128" y="266">NODE / 02</text>
          <text x="602" y="205">RHODES ISLAND</text>
          <text x="790" y="101" text-anchor="end">SIGNAL / 07</text>
          <text x="790" y="350" text-anchor="end">ORIGINIUM DENSITY 0.71</text>
        </g>
      </svg>
      <div class="tl-telemetry-foot">
        <span>ROUTE MEMORY / STABLE</span>
        <strong>TERRA // ACTIVE</strong>
      </div>
    </div>
  </header>

  <div id="ark-chronicle-directory" class="ark-chronicle-directory" role="region" tabindex="-1" aria-labelledby="ark-directory-title">
    <header class="ark-directory-head">
      <p>CHRONICLE CHAPTER INDEX / TERRA</p>
      <h2 id="ark-directory-title">章节目录</h2>
      <p>按时代与时间段查阅主世界线；关键节点可直接进入，短篇同期档案在正文中展开。</p>
    </header>
    <a class="ark-reader-resume" data-ark-reader-resume data-ark-reader-target hidden>
      <span>继续上次阅读</span>
      <strong data-ark-reader-resume-title></strong>
    </a>
    <div id="ark-chapter-list" class="ark-chapter-list" aria-live="polite"></div>
  </div>
</div>

<noscript>
  <article class="ark-noscript-chronicle" aria-labelledby="ark-noscript-title">
    <header>
      <p>STATIC TERRA RECORD / FULL ARCHIVE</p>
      <h2 id="ark-noscript-title">泰拉主编年静态档案</h2>
      <span>当前浏览器未启用脚本；以下直接展示主世界线的 {{ arknightsChronicle.records }} 条记录。</span>
    </header>
    {% for era in arknightsChronicle.eras %}
    <section class="ark-noscript-era">
      <h3>{{ era.title }}</h3>
      {% for record in era.events %}
      <article id="{{ record.id }}" class="ark-noscript-record" data-arknights-record="{{ record.id }}">
        <time>{{ record.dateDisplay }}</time>
        <h4>{{ record.title }}</h4>
        <p data-arknights-description>{{ record.description }}</p>
        {% if record.sources and record.sources.length %}
        <footer>
          {% for source in record.sources %}
          <a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.title or source.text }} ↗</a>
          {% endfor %}
        </footer>
        {% elif record.prtsSources and record.prtsSources.length %}
        <footer>
          {% for source in record.prtsSources %}
          <a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.text or source.title }} ↗</a>
          {% endfor %}
        </footer>
        {% endif %}
      </article>
      {% endfor %}
    </section>
    {% endfor %}
  </article>
</noscript>

<section id="ark-reader" class="ark-reader" role="dialog" aria-modal="true" aria-labelledby="ark-reader-title" aria-hidden="true" aria-keyshortcuts="Escape" hidden>
  <header class="ark-reader-toolbar">
    <div>
      <p>RHODES ISLAND / CONTINUOUS ARCHIVE</p>
      <h2 id="ark-reader-title">连续阅读</h2>
    </div>
    <label class="ark-reader-progress-label">
      <span class="sr-only">阅读进度</span>
      <progress data-ark-reader-progress max="100" value="0"></progress>
      <output data-ark-reader-progress-text aria-live="polite">0 / {{ arknightsChronicle.records }}</output>
    </label>
    <div class="ark-reader-toolbar-actions">
      <button type="button" data-ark-reader-previous aria-label="上一章">上一章</button>
      <button type="button" data-ark-reader-next aria-label="下一章">下一章</button>
      <button type="button" data-ark-reader-close class="ark-reader-close" aria-label="关闭连续阅读器">关闭</button>
    </div>
  </header>
  <div class="ark-reader-grid">
    <nav class="ark-reader-index" aria-label="时代与章节索引">
      <div id="ark-reader-index-list"></div>
    </nav>
    <div id="ark-reader-scroll" class="ark-reader-scroll" tabindex="0">
      <div id="ark-reader-content" class="ark-reader-content"></div>
    </div>
    <details class="ark-reader-context-panel" open>
      <summary>当前记录与来源</summary>
      <aside id="ark-reader-context" class="ark-reader-context" aria-label="当前记录与来源"></aside>
    </details>
  </div>
</section>
{% endblock %}
